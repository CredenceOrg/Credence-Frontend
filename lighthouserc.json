{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/dashboard",
        "http://localhost:4173/bond",
        "http://localhost:4173/trust",
        "http://localhost:4173/attestations",
        "http://localhost:4173/transactions",
        "http://localhost:4173/settings"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://localhost:4173/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4173/dashboard$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4173/bond$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4173/trust$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4173/attestations$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4173/transactions$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4173/settings$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports"
    }
  }
}
